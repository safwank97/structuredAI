# Copy to .env for local development. Real deployments set these as
# Container App env-vars / secretRefs instead -- this file never carries a
# real secret, only local-dev throwaway values.

ENVIRONMENT=local

# Set to true for local dev so secrets come from plain env vars below
# instead of Key Vault + managed identity (which only works when actually
# running in Azure, or from a laptop that's `az login`-ed with read access
# to acb-msak-kvault).
LOCAL_DEV_SECRETS=true

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cplane_dev
POSTGRES_APP_USER=acb_app
POSTGRES_APP_PASSWORD=testpw123

JWT_SECRET_KEY=local-dev-only-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Only needed for `alembic upgrade head` (admin connection), not by the app
# itself -- see alembic/env.py.
DATABASE_URL=postgresql+asyncpg://postgres:localtestpw@localhost:5432/cplane_dev
ACB_APP_ROLE_PASSWORD=testpw123

# Real Azure Service Bus -- confirmed against the actual namespace
# (acb-msak-svc-bs), ONE queue (acb-msak-sbq-agent-runs, session-enabled),
# TWO separately-scoped SAS connection strings, not one shared value:
#   SERVICE_BUS_SEND_CONNECTION_STRING   <- Key Vault secret
#     sas-arp-sbq-agent-runs-cplane-send-strb-pconnstr   (send-only; api uses this)
#   SERVICE_BUS_LISTEN_CONNECTION_STRING <- Key Vault secret
#     sas-arp-sbq-agent-runs-sbxjb2-listen-strb-pconnstr (listen-only; sandbox-worker uses this)
# Paste your real values here for local dev only, in your own .env (copied
# from this .example template) -- NEVER commit a real connection string.
# Confirm your own .gitignore excludes .env before pasting a real secret
# into it; no .gitignore existed in the mirrored copy this was originally
# built against (one was added, but verify on your own machine too).
SERVICE_BUS_SEND_CONNECTION_STRING=Endpoint=sb://acb-msak-svc-bs.servicebus.windows.net/;SharedAccessKeyName=REPLACE-ME;SharedAccessKey=REPLACE-ME;EntityPath=acb-msak-sbq-agent-runs
SERVICE_BUS_LISTEN_CONNECTION_STRING=Endpoint=sb://acb-msak-svc-bs.servicebus.windows.net/;SharedAccessKeyName=REPLACE-ME;SharedAccessKey=REPLACE-ME;EntityPath=acb-msak-sbq-agent-runs

# Real Azure Cache for Redis (acb-msak-redis) -- now required, by BOTH
# result-consumer (reads the result stream) and sandbox-worker (publishes
# to it); see app/worker/result_consumer.py and
# sandbox_worker/result_publisher.py. Key Vault secret name:
# acb-msak-redis-pkey. Non-SSL access is disabled on the real cache, so
# this is always the SSL port (6380) -- both consumers of this value
# already default to the real host/port, so only the password needs to be
# supplied here. Both services currently use the SAME value (there is no
# separate write-scoped Redis credential the way Service Bus has a send-
# vs-listen split) -- see DEFERRED_ITEMS.md.
REDIS_PASSWORD=REPLACE-ME

# Does NOT exist as a real Key Vault secret yet -- only the Postgres ADMIN
# password (acb-msak-pg-admin-password) has ever been created. This is the
# secret name app/config.py expects once the acb_app runtime role and its
# own password are created for real; see the walkthrough for creating both.
# Local dev (LOCAL_DEV_SECRETS=true) never touches this -- POSTGRES_APP_PASSWORD
# above is a throwaway local value with no connection to the real Key Vault.
# Key Vault secret name once created: acb-msak-pg-app-password

# --- Real LLM call (optional -- defaults keep local dev on the free,
# instant stub; nothing below is required for docker-compose) ---
# LOCAL_DEV_LLM_STUB defaults to true (app/config.py) and docker-compose.yml
# never overrides it, so a normal local run never places a real, billed
# call. Set it to false here only if you deliberately want this laptop's
# `api` process to call the real model via APIM -- unlike Key Vault, the
# APIM gateway's public endpoint IS reachable from outside the VNet
# (virtualNetworkType: External only restricts APIM's own OUTBOUND calls
# to its backends/Key Vault to the VNet, not inbound gateway traffic), so
# this works from a laptop without any break-glass step. Real cost applies
# per call once this is false -- see ANTHROPIC_PRICING_USD_PER_MTOK in
# app/api/v1/runs.py for the rate used to compute run_usage.cost_usd.
# LOCAL_DEV_LLM_STUB=false
# APIM_ANTHROPIC_GATEWAY_URL=https://acb-msak-apim.azure-api.net/anthropic/v1/messages
# ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_MAX_TOKENS=2048
# ANTHROPIC_TIMEOUT_SECONDS=60
